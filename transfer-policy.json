{
  "newFileMode": "0764",
  "symlinkDepthLimit": 32,
  "dropDiagnostics": {
    "enabledMarker": "enable-drop-trace",
    "file": "drop-trace.jsonl",
    "heartbeatMs": 1000,
    "maxRecords": 15000,
    "maxPendingRecords": 256,
    "methods": [
      "onDrop",
      "_customDeferDrop",
      "_customStageDropFile",
      "_customUploadLocalPaths",
      "_streamUploadOne",
      "_pumpUploadQueue",
      "_runQueuedUpload",
      "uploadPathToRemote",
      "_doUpload",
      "refreshRemote",
      "_safeDetect",
      "customPasteImage",
      "ctxClipboardPaste",
      "_streamDownloadOne",
      "_pumpDownloadQueue",
      "_runQueuedDownload",
      "_doDownload",
      "_doUploadRaw",
      "_doDownloadRaw",
      "_customQueueEditTransfer",
      "_customDownloadForEdit",
      "_customUploadForEdit",
      "_customDownloadToDirectory",
      "trackTransfer",
      "pauseTransfer",
      "resumeTransfer",
      "cancelTransfer",
      "toggleCustomSidebarPin",
      "toggleCustomSidebarMode",
      "toggleCustomSidebarFull",
      "_scheduleLayoutRefresh",
      "closeContextMenu",
      "ctxNewFile"
    ],
    "flushBeforeMethods": [
      "_customUploadLocalPaths",
      "_streamUploadOne",
      "_runQueuedUpload",
      "uploadPathToRemote",
      "_doUpload",
      "_streamDownloadOne",
      "_runQueuedDownload",
      "_doDownload",
      "_doUploadRaw",
      "_doDownloadRaw",
      "_customQueueEditTransfer",
      "_customDownloadForEdit",
      "_customUploadForEdit",
      "_customDownloadToDirectory"
    ],
    "maxErrorFrames": 8,
    "heartbeatMaxSpans": 16,
    "chunkTraceLimit": 32,
    "criticalSyncPhases": [
      "clipboard:key:capture",
      "clipboard:key:capture-route",
      "clipboard:key-route",
      "runtime:zone:error",
      "runtime:window:error",
      "runtime:promise:error",
      "toggleCustomSidebarPin:start",
      "toggleCustomSidebarPin:error",
      "toggleCustomSidebarPin:end",
      "_safeDetect:error",
      "sidebar:pin:start",
      "sidebar:pin:config:start",
      "sidebar:pin:config:return",
      "sidebar:pin:layout:start",
      "sidebar:pin:layout:end",
      "sidebar:pin:detect:start",
      "sidebar:pin:detect:end",
      "sidebar:pin:resize:start",
      "sidebar:pin:resize:end",
      "sidebar:pin:end",
      "sidebar:pin:error"
    ]
  },
  "tabbyDiagnostics": {
    "enabledMarker": "enable-tabby-trace",
    "file": "tabby-runtime.jsonl",
    "backupFile": "tabby-runtime.previous.jsonl",
    "channel": "sftp-plus-plus:diagnostic-heartbeat",
    "heartbeatMs": 2000,
    "rendererHeartbeatMs": 1000,
    "maxBytes": 2097152,
    "maxRecords": 20000,
    "maxMetrics": 16,
    "maxErrorFrames": 8
  },
  "windowsOpenWith": {
    "executable": "System32/WindowsPowerShell/v1.0/powershell.exe",
    "script": "windows-open-with.ps1",
    "arguments": [
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-WindowStyle",
      "Hidden",
      "-File"
    ],
    "flags": 4,
    "cancelExitCode": 2
  },
  "newFileOpenFlags": 42,
  "fileList": {
    "pageSize": 200,
    "navigationMemoryLimit": 200
  },
  "externalEdit": {
    "remoteChangeAction": "overwrite",
    "restoreWatchers": false
  },
  "terminalCommands": {
    "park": "\u001b999999\u001bf#\u001b999999\u001b\b",
    "submit": "\r",
    "restore": "\u0019\b"
  }
}
